# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Master Configuration
MASTER_PORT=8100
MASTER_HOST=0.0.0.0

# Worker Configuration
DISCIPLINE=新闻传播学
THREAD_COUNT=3

# Proxy Configuration (Clash for Windows)
PROXY_URL=http://127.0.0.1:7890
PROXY_ENABLED=true

# CNKI Configuration
CNKI_BASE_URL=https://kns.cnki.net
CNKI_NAVI_URL=https://navi.cnki.net/knavi

# Storage
STORAGE_BASE=../数据库/cnki

# HuggingFace Models Directory
HF_MODELS_DIR=./models

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/cnki-downloader.log

# Health Check
HEARTBEAT_INTERVAL=10
HEARTBEAT_TIMEOUT=30
TASK_STALL_TIMEOUT=900

# Rate Limiting
DEFAULT_DELAY_MIN=0.5
DEFAULT_DELAY_MAX=3.0
SUSPICIOUS_DELAY_MULTIPLIER=2.0
BLOCKED_COOLDOWN_MINUTES=15
