# ═══════════════════════════════════════════════════════════════
# ScholarMind Agent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ═══════════════════════════════════════════════════════════════

# ── 版本与环境 ──
VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true

# ── DeepSeek API 配置 ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 数据库配置 ──
# 异步 ORM 数据库 (SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///data/scholarmind_orm.db
# SQLite 原生数据库 (db_service)
DB_PATH=data/scholarmind.db

# ── PostgreSQL（docker-compose 生产部署必填，未设置则启动失败）──
# P1 Task 13：移除弱口令默认值，部署时必须在 .env 中显式提供
POSTGRES_USER=scholarmind
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=scholarmind

# ── 向量数据库 (ChromaDB) ──
CHROMA_DIR=data/chroma

# ── Redis & Celery 分布式任务调度 ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Redis 访问密码（生产环境必须修改；docker-compose 中 redis-server --requirepass 强制启用）
REDIS_PASSWORD=change_me_in_production
# 后台任务后端: "celery" (分布式) 或 "background" (本地线程)
TASK_BACKEND=background

# ── 爬虫配置 ──
CRAWL_RATE_LIMIT=3.0
CRAWL_MAX_RETRIES=3
CRAWL_DATA_RETENTION_DAYS=30

# ── RAG 配置 ──
RAG_ENABLED=false
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── 数据源 URL ──
WANFANG_BASE_URL=https://www.wanfangdata.com.cn
WEIPU_BASE_URL=https://qikan.cqvip.com

# ── CNKI 反爬配置 ──
# curl_cffi TLS 指纹模拟目标 (chrome120/chrome121/chrome123/chrome124)
CNKI_TLS_IMPERSONATE=chrome124
# cnki-downloader Master 节点桥接
CNKI_MASTER_URL=http://localhost:8100
CNKI_MASTER_ENABLED=false
# 外部打码平台 API Key (capsolver/2captcha)
CNKI_CAPTCHA_API_KEY=

# ── 学术搜索配置 ──
# Semantic Scholar API（可选，无 key 使用免费 tier，有 key 可提高速率限制）
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
# arXiv API
ARXIV_BASE_URL=http://export.arxiv.org/api/query
# 全局搜索配置
ACADEMIC_SEARCH_TIMEOUT=15
ACADEMIC_SEARCH_MAX_CONCURRENT=5
ACADEMIC_SEARCH_CACHE_TTL=1800

# ── 应用配置 ──
APP_HOST=0.0.0.0
APP_PORT=8000
# 文件上传与存储目录
UPLOAD_DIR=data/uploads
SKILLS_DIR=data/skills
CHARTS_DIR=data/charts
CONVERSATIONS_DIR=data/conversations
MAX_FILES_PER_SESSION=15
MIN_FILES_PER_SESSION=1
MAX_FILE_SIZE_MB=20

# ── CORS 配置 ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 开发环境允许所有源（生产环境强制白名单）
CORS_ALLOW_ALL_IN_DEV=false

# ── 结构化日志 ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── 速率限制 ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60

# ── JWT 认证 ──
# 生产环境必须设置，否则使用空字符串（仅限开发）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8

# 配置完真实商户凭证后再开启；生产环境必须保持回调验签
PAYMENT_ENABLED=false
PAYMENT_VERIFY_REQUIRED=true

# ── 免费配额 ──
FREE_TIER_TOKEN_LIMIT=1000000
FREE_TIER_MODEL=flash
PRO_TIER_TOKEN_LIMIT=10000000
FREE_CHAT_LIMIT=20

# ── 微信支付 ──
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/payment/wechat/notify

# ── 支付宝 ──
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payment/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/app/interactive-prototype.html#payment
ALIPAY_SELLER_ID=
ALIPAY_SANDBOX=true

# ── 邮箱验证码（支持 QQ/163/126/Gmail/Outlook 等主流邮箱）──
# 只需填写 SMTP_USER 和 SMTP_PASSWORD，服务器自动从邮箱域名检测
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-auth-code
# 各平台授权码获取方式：
#   QQ邮箱: 设置→账户→POP3/SMTP→开启→生成授权码
#   163邮箱: 设置→POP3/SMTP/IMAP→开启→新增授权码
#   Gmail:   设置→应用专用密码（需开启两步验证）
SMTP_FROM_NAME=ScholarMind
VERIFICATION_CODE_EXPIRE_MINUTES=5
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_RATE_LIMIT_SECONDS=60

# ── Resend HTTP API（Railway 等 SMTP 封锁环境推荐）──
# 免费模式只能发到账户邮箱；验证自定义域名后可发到任意收件人
RESEND_API_KEY=
RESEND_FROM_DOMAIN=quannengyanjiu.cn

# ── Vercel 邮件代理（推荐 Railway 部署使用）──
# Vercel Serverless Function 通过 SMTP 发送邮件，绕过 Railway SMTP 端口封锁
# 需要在 Vercel 项目设置中配置相同的 SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD/EMAIL_PROXY_KEY
VERCEL_EMAIL_PROXY_URL=https://www.quannengyanjiu.cn/api/send-email
VERCEL_EMAIL_PROXY_KEY=your_secure_random_key_here

# ── 个人收款码支付模式 ──
# 设为 true 时使用本地收款码图片，不依赖微信/支付宝官方API
PERSONAL_QR_MODE=true
# 设为 true 时需要管理员手动确认支付；false 则用户点击"我已支付"后自动到账
MANUAL_PAYMENT_CONFIRM=false

# P1 Task 17：套餐定价已迁移至 src/backend/services/entitlement_service.py 的 PRODUCTS 字典
# （amount_cents 字段，单位：分）。.env 不再持有 PRO_MONTHLY_PRICE/PRO_YEARLY_PRICE。
