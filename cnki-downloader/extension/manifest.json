{
  "manifest_version": 3,
  "name": "CNKI Auto PDF Download",
  "version": "1.1",
  "description": "Auto-injects CNKI cookies and clicks PDF download button",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://*.cnki.net/*",
    "https://www.cnki.net/*",
    "https://kns.cnki.net/*",
    "https://navi.cnki.net/*",
    "https://bar.cnki.net/*",
    "https://login.cnki.net/*",
    "https://rss.cnki.net/*",
    "https://x.cnki.net/*",
    "https://gateway.cnki.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kns.cnki.net/kcms2/article/abstract*",
        "https://kns.cnki.net/kcms/detail/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
