{
  "installCommand": "npm --prefix src/frontend install --no-audit --no-fund",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "functions": {
    "api/send-email.js": {
      "maxDuration": 10
    },
    "api/platform-status.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!platform-status|send-email|send-team-invite).*)",
      "destination": "https://lodging-fossil-significantly-sleeping.trycloudflare.com/api/$1"
    },
    {
      "source": "/((?!api/|ws/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
